#-----------------------------
#filter DEGS function 
#----------------------------------

filter_DEGs <- function(df, region, pval_cols, logFC_cols, direction = "up") {
  if (nrow(df) == 0 || !region %in% names(pval_cols)) return(tibble())
  
  pcol <- pval_cols[[region]]
  logFCcol <- logFC_cols[[region]]
  
  if (!all(c(pcol, logFCcol) %in% colnames(df))) return(tibble())
  
  if (direction == "up") {
    df %>% filter(.data[[pcol]] < 0.05, .data[[logFCcol]] > 0)
  } else if (direction == "down") {
    df %>% filter(.data[[pcol]] < 0.05, .data[[logFCcol]] < 0)
  } else {
    stop("Direction must be 'up' or 'down'")
  }
}
#--------------------------------------------------
#proportion function
#------------------------------------------------
compute_proportions <- function(marker_lists, DEoutp, cluster_class_map,
                                        treatments = list(
                                          SAL = list(pval = pval_col_sal, logFC = logFC_col_sal),
                                          FENT = list(pval = pval_col_fent, logFC = logFC_col_fent)
                                        ),
                                        directions = c("up", "down")) {
  
  all_results <- list()
  
  for (marker_name in names(marker_lists)) {
    marker_list <- marker_lists[[marker_name]]
    
    for (treat_name in names(treatments)) {
      pval_cols <- treatments[[treat_name]]$pval
      logFC_cols <- treatments[[treat_name]]$logFC
      
      for (dir in directions) {
        
        message("Computing proportions: ", marker_name, " | ", treat_name, " | ", dir)
        
        for (region in names(DEoutp)) {
          DE_df <- DEoutp[[region]]
          
          # Rename mgi_symbol to gene if needed
          if ("mgi_symbol" %in% colnames(DE_df)) DE_df <- dplyr::rename(DE_df, gene = mgi_symbol)
          
          # Skip if no columns exist
          if (!(region %in% names(pval_cols)) || !all(c(pval_cols[[region]], logFC_cols[[region]]) %in% colnames(DE_df))) next
          
          # Filter DEGs 
          deg_vector <- filter_DEGs(DE_df, region, pval_cols, logFC_cols, direction = dir) %>% 
            dplyr::pull(gene) %>% unique()
          
          deg_total <- length(deg_vector)
          all_markers <- unique(unlist(marker_list))
          deg_in_any_cluster <- deg_vector[deg_vector %in% all_markers]
          total_in_cluster <- length(deg_in_any_cluster)
          
          # Loop over cluster classes
          prop_df <- lapply(names(cluster_class_map), function(class_name) {
            clusters <- cluster_class_map[[class_name]]
            class_genes <- unique(unlist(marker_list[clusters]))
            overlap <- sum(deg_vector %in% class_genes)
            
            data.frame(
              class = class_name,
              overlap = overlap,
              prop_total_deg = overlap / deg_total,
              prop_cluster_deg = ifelse(total_in_cluster > 0, overlap / total_in_cluster, NA),
              region = region,
              method = marker_name,
              treatment = treat_name,
              direction = dir
            )
          }) %>% dplyr::bind_rows()
          
          all_results[[paste(marker_name, treat_name, dir, region, sep = "_")]] <- prop_df
        }
      }
    }
  }
  
  dplyr::bind_rows(all_results)
}






all_proportions <- compute_proportions(marker_lists, DEoutp, cluster_class_map)

readr::write_tsv(all_proportions, "proportionalcelltyperesults_new.tsv")
