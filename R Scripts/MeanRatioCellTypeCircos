# Define clusters and regions
clusters <- unique(df$cluster)
regions <- c("PFC", "NAC")


FDRval_colors <- colorRamp2(c(0, 1.2999, 1.3, 3.5), c("white", "white", "yellow", "springgreen"))
overlap_colors <- colorRamp2(c(0,40), c("white", "deeppink3"))
prop_colors <- colorRamp2(c(0, 0.11), c("white", "deepskyblue3"))

pdf("circosplot_MRenrichment.pdf", width=9.5, height =7)
circos.clear()
circos.par(
  start.degree= -180,
  gap.degree =0.2,
  track.margin=c(0.001,0.001),
  cell.padding=c(0,0,0,0)
  )
df$cluster <- factor(df$cluster, levels = desired_order)

circos.initialize(factors = df$cluster, xlim = c(0,1)
)
#------------------------
#labeling track for cell type
#----------------------------
circos.track(
  sectors = levels(df$cluster),
  ylim = c(0, 1),
  track.height = 0.08,
  bg.col = cluster_colors[levels(df$cluster)],
  bg.border = NA,
  panel.fun = function(x, y) {
    
    sector_name <- CELL_META$sector.index
    xcenter <- CELL_META$xcenter
    ycenter <- CELL_META$ycenter
    
    circos.text(
      xcenter,
      ycenter,
      labels = sector_name,
      facing = "inside",
      niceFacing = TRUE,
      cex = 0.5,
      col = "black"
    )
  }
)
# -------------------
# Outermost track: prop_cluster (heatmap)
# -------------------
circos.track(factors=df$cluster, y=df$prop_cluster, track.height=0.1, panel.fun=function(x,y){
  sector.index <- get.cell.meta.data("sector.index")
  vals <- df %>% filter(cluster==sector.index)
  y_bottom <- 0
  for(i in seq_len(nrow(vals))){
    circos.rect(0, y_bottom, 1, y_bottom+1, col=prop_colors(vals$prop_cluster[i]), border=NA)
    circos.text(0.5, y_bottom+0.5, vals$region[i], cex=0.5, facing="inside", niceFacing=TRUE)
    y_bottom <- y_bottom + 1
  }
}, ylim=c(0,2))
# -------------------
# Middle track: overlap
# -------------------
circos.track(factors=df$cluster, y=df$overlap, track.height=0.1, panel.fun=function(x,y){
  sector.index <- get.cell.meta.data("sector.index")
  vals <- df %>% filter(cluster == sector.index)
  y_bottom <- 0
  for(i in seq_len(nrow(vals))){
    circos.rect(0, y_bottom, 1, y_bottom + 1,
                col = overlap_colors(vals$overlap[i]), border=NA)
       y_bottom <- y_bottom + 1
  }
}, ylim=c(0,2))


# -------------------
# Innermost track: logFDR
# -------------------
circos.track(factors=df$cluster, y=df$logFDR, track.height=0.1, panel.fun=function(x,y){
  sector.index <- get.cell.meta.data("sector.index")
  vals <- df %>% filter(cluster == sector.index)
  y_bottom <- 0
  for(i in seq_len(nrow(vals))){
    circos.rect(0, y_bottom, 1, y_bottom + 1,
                col = FDRval_colors(vals$logFDR[i]), border=NA)
    
    y_bottom <- y_bottom + 1
  }
}, ylim=c(0,2))



# -------------------------------
# Legends for each track
# -------------------------------

# 1. logFDR
lgd_logFDR <- Legend(
  title = "logFDR",
  col_fun = FDRval_colors,
  at = c(0, 1.3, 3.5),
  labels = c(0,1.3,3.5),
  direction = "horizontal",
  title_position = "topcenter"
)

# 2. overlap
lgd_overlap <- Legend(
  title = "# overlapping genes",
  col_fun = overlap_colors,
  direction = "horizontal",
  title_position = "topcenter"
)

# 3. prop_cluster
lgd_prop <- Legend(
  title = "Percent cluster mapping",
  col_fun = prop_colors,
  at=c(0,0.05,0.1),
  labels=c(0,5,10),
  
  direction = "horizontal",
  title_position = "topcenter"
)

# -------------------------------
# Draw the legends
# -------------------------------

# Combine all legends into one block
lgd_all <- packLegend(lgd_logFDR, lgd_overlap, lgd_prop, gap = unit(2, "mm"))

# Draw them at the bottom of the plot
draw(lgd_all, x = unit(0.15, "npc"), y = unit(0.05, "npc") + unit(0.05, "cm"), just = c("center","bottom"))
