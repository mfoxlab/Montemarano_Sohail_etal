#  refining top neuron markers as defined from findmarkers() in Seurat from Fox et al Addiction Biology

ranked_markers <- lapply(markers, function(df) {
  df <- tibble::rownames_to_column(df,var="gene")
  
  # Ensure numeric columns are numeric
  numeric_cols <- c("avg_log2FC", "p_val", "p_val_adj", "pct.1", "pct.2")
  for (col in numeric_cols) {
    if (col %in% colnames(df)) {
      df[[col]] <- as.numeric(df[[col]])
    }
  }
  
  # Keep only positive log2FC and sort
  df %>%
    filter(avg_log2FC > 0) %>%
    arrange(p_val_adj, desc(avg_log2FC)) 
})

