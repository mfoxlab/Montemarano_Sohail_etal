#-------------------------------
# Fisher enrichment per cluster function
#-------------------------------
run_fisher <- function(DE_table, region, pval_cols, logFC_cols, top_markers_list, direction = "up") {
  
  # Return NULL if no DE data or region not defined
  if (nrow(DE_table) == 0 || !region %in% names(pval_cols)) return(NULL)
  
  # Rename 'mgi_symbol' to 'gene' to match marker lists
  if ("mgi_symbol" %in% colnames(DE_table)) {
    DE_table <- DE_table %>% dplyr::rename(gene = mgi_symbol)
  } else if (!"gene" %in% colnames(DE_table)) {
    stop(paste0("DE table for region ", region, " has no 'gene' or 'mgi_symbol' column"))
  }
  
  pcol <- pval_cols[[region]]
  logFCcol <- logFC_cols[[region]]
  if (!all(c(pcol, logFCcol) %in% colnames(DE_table))) return(NULL)
  
  # Select DEGs based on direction
  deg_genes <- DE_table %>%
    dplyr::filter(.data[[pcol]] < 0.05,
                  if (direction == "up") .data[[logFCcol]] > 0 else .data[[logFCcol]] < 0) %>%
    dplyr::pull(gene)
  
  universe_genes <- DE_table$gene
  deg_genes <- intersect(deg_genes, universe_genes)
  
  cluster_results <- lapply(names(top_markers_list), function(cluster) {
    cluster_genes <- intersect(top_markers_list[[cluster]]$gene, universe_genes)
    overlap_genes <- intersect(cluster_genes, deg_genes)
    
    a <- length(overlap_genes)
    b <- length(setdiff(cluster_genes, deg_genes))
    c <- length(setdiff(deg_genes, cluster_genes))
    d <- length(setdiff(universe_genes, union(cluster_genes, deg_genes)))
    
    fisher_test <- fisher.test(matrix(c(a, b, c, d), nrow = 2), alternative = "greater")
    
    tibble::tibble(
      region = region,
      cluster = cluster,
      direction = direction,   # Track up or down
      overlap = a,
      cluster_size = length(cluster_genes),
      deg_total = length(deg_genes),
      universe_total = length(universe_genes),
      odds_ratio = unname(fisher_test$estimate),
      p_value = fisher_test$p.value,
      overlap_genes = paste(overlap_genes, collapse = ", ")
    )
  })
  
  dplyr::bind_rows(cluster_results)
}

#-------------------------------
# function to Run Fisher for a given marker list and condition
#-------------------------------
run_fisher_for_all <- function(top_markers_list, DE_list, pval_cols, logFC_cols, direction = "up") {
  result <- lapply(names(DE_list), function(region) {
    run_fisher(DE_list[[region]], region, pval_cols, logFC_cols, top_markers_list, direction)
  }) %>%
    dplyr::bind_rows() %>%
    dplyr::mutate(FDR = p.adjust(p_value, method = "BH"))
  
  return(result)
}


