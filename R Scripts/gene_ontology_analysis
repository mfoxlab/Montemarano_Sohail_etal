#-------------------------------------------------------
# Function to later convert Ensembl to mgi_symbols
#--------------------------------------------------------
mouse_mart <- useMart("ensembl", dataset = "mmusculus_gene_ensembl")

ensembl_to_mgi <- getBM(
  attributes = c("ensembl_gene_id", "mgi_symbol"),
  mart = mouse_mart
)

convert_ensembl_to_mgi <- function(ensembl_str, mapping_df) {
  ensembl_ids <- unlist(strsplit(ensembl_str, "\\|"))
  mapped_symbols <- mapping_df %>%
    filter(ensembl_gene_id %in% ensembl_ids) %>%
    pull(mgi_symbol)
  # Return MGI symbols separated by |
  paste(unique(na.omit(mapped_symbols)), collapse = "|")
}


PFC_each_go_result <- list()
total_modules<-length(PFC_sig_modules)
for (i in seq_along(PFC_sig_modules)) {
  
  module <- PFC_sig_modules[i]
  
  message(
    sprintf(
      "[%d/%d] Running module %s...",
      i, total_modules, module
    )
  )
  
  
  current_module <- PFC_gene_summary %>%
    filter(module.PFC == module) %>%
    dplyr::select(ensembl_gene_id) %>%  
    distinct() %>%
    pull()
 
   # Store original IDs
  original_module <- current_module

   #clean up ensemblIDs if needed
  cleaned_module <- sub("\\..*", "", original_module)
   # Report genes that were altered by cleaning
   changed_ids <- original_module[original_module != cleaned_module]
   
   if (length(changed_ids) > 0) {
     message(
       paste0(
         "Module ", module, ": ",
         length(changed_ids),
         " genes had version numbers removed."
       )
     )
   }
   
   # Identify genes not in universe
   missing_from_universe <- cleaned_module[!cleaned_module %in% gene_universe]
   
   if (length(missing_from_universe) > 0) {
     message(
       paste0(
         "Module ", module, ": ",
         length(missing_from_universe),
         " genes not found in background universe."
       )
     )
   }
   
   # Keep only valid genes
   current_module <- cleaned_module[cleaned_module %in% gene_universe]
   
   message(
     paste0(
       "Module ", module, 
       ": ", length(current_module), 
       " genes entering GO analysis."
     )
   )
  
   # Run GO with custom background
  gost_result <- gost(
    query             = current_module,
    organism          = "mmusculus",
    sources           = c("GO:BP", "GO:CC", "GO:MF"),
    correction_method = "fdr", 
    significant       = TRUE, 
    evcodes           = TRUE,
    user_threshold    = 0.05,
    custom_bg         = gene_universe,
    domain_scope      = "custom"
  )
  
  # Add module label if results exist
  if (!is.null(gost_result) && !is.null(gost_result$result)) {
    
    gost_result_df <- gost_result$result
    gost_result_df$module <- module
    
    PFC_each_go_result[[as.character(module)]] <- gost_result_df
    
  } else {
    
    message(paste("Module", module, "outputted a NULL result"))
    
  }
  message(paste0("Module ", module, " complete.\n"))
}
PFC_go_all_modules <- bind_rows(PFC_each_go_result)

PFC_go_all_modules_cleaned <- PFC_go_all_modules %>%
  dplyr::select(-query) %>%
  dplyr::select(module, everything(), -significant, significant) %>%
  mutate(intersection = gsub(",", "|", intersection),
         evidence_codes = gsub(",", "|", evidence_codes))

PFC_go_all_modules_cleaned <- PFC_go_all_modules_cleaned %>%
  rowwise() %>%
  mutate(intersection = convert_ensembl_to_mgi(intersection, ensembl_to_mgi)) %>%
  ungroup()

readr::write_tsv(PFC_go_all_modules_cleaned, "restrictedGeneUniversePFCGO.tsv")


